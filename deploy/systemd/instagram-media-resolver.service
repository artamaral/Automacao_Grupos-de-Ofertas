[Unit]
Description=Resolve Instagram media assets for the daily Shopee plan
Wants=network-online.target
After=network-online.target shopee-candidate-refresh.service

[Service]
Type=oneshot
User=ofertas-refresh
Group=ofertas-refresh
WorkingDirectory=/opt/automacao_grupo_compras/app
ExecStart=/bin/bash /opt/automacao_grupo_compras/app/scripts/ops/run_instagram_media_resolver.sh
TimeoutStartSec=45min
Nice=5

[Install]
WantedBy=multi-user.target
