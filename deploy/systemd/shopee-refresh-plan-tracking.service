[Unit]
Description=Shopee refresh, daily plan and tracked links
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ofertas-refresh
Group=ofertas-refresh
WorkingDirectory=/opt/automacao_grupo_compras/app
ExecStart=/bin/bash /opt/automacao_grupo_compras/app/scripts/ops/run_shopee_refresh_plan_tracking.sh
TimeoutStartSec=60min
Nice=5

[Install]
WantedBy=multi-user.target
